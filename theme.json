{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "760px", "wideSize": "1220px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Crema", "color": "#F3EDE0" },
				{ "slug": "paper", "name": "Carta", "color": "#FBF8F1" },
				{ "slug": "contrast", "name": "Inchiostro", "color": "#262A1F" },
				{ "slug": "primary", "name": "Oliva", "color": "#4F6B2C" },
				{ "slug": "primary-dark", "name": "Bosco", "color": "#34481C" },
				{ "slug": "secondary", "name": "Viola", "color": "#4A2C7F" },
				{ "slug": "sage", "name": "Salvia", "color": "#D8E2C3" },
				{ "slug": "lavender", "name": "Lavanda", "color": "#E3D9F1" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"name": "Oswald", "slug": "display", "fontFamily": "Oswald, 'Arial Narrow', sans-serif",
					"fontFace": [ { "fontFamily": "Oswald", "fontWeight": "400 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/oswald.woff2" ] } ]
				},
				{
					"name": "Nunito Sans", "slug": "body", "fontFamily": "'Nunito Sans', system-ui, sans-serif",
					"fontFace": [ { "fontFamily": "Nunito Sans", "fontWeight": "400 800", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/nunito-sans.woff2" ] } ]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Piccolo", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medio", "size": "1.0625rem" },
				{ "slug": "large", "name": "Grande", "size": "1.35rem", "fluid": { "min": "1.2rem", "max": "1.35rem" } },
				{ "slug": "x-large", "name": "Molto grande", "size": "2.4rem", "fluid": { "min": "1.8rem", "max": "2.4rem" } },
				{ "slug": "huge", "name": "Enorme", "size": "5.5rem", "fluid": { "min": "3rem", "max": "6rem" } }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.65" },
		"spacing": {
			"blockGap": "1.25rem",
			"padding": { "left": "clamp(16px, 4vw, 40px)", "right": "clamp(16px, 4vw, 40px)" }
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "textTransform": "uppercase", "lineHeight": "1.02", "letterSpacing": "0" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
			"h2": { "typography": { "fontSize": "clamp(2.1rem, 4.4vw, 3.4rem)" } },
			"h3": { "typography": { "fontSize": "clamp(1.4rem, 2vw, 1.75rem)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": { "color": { "text": "var(--wp--preset--color--primary)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--secondary)", "text": "#FFFFFF" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "fontSize": "1.05rem", "textTransform": "uppercase", "letterSpacing": "0.05em" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.85em", "bottom": "0.85em", "left": "1.7em", "right": "1.7em" } },
				":hover": { "color": { "background": "var(--wp--preset--color--primary)", "text": "#FFFFFF" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
